<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="~/Content/Datatables/css/datatables.min.css" rel="stylesheet" />
    <link href="~/Content/FontAwesome/css/all.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            <div>
                <a class="navbar-brand fw-bold" href=@Url.Action("Index", "Home")>

                    <img src=@Url.Content("~/Content/Images/PhoneBook.png") alt="PhoneBook" width="30" height="30" class="d-inline-block align-top" />
                    <span class="text-primary">Phone</span><span class="text-dark">Book</span>
                </a>
            </div>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-light" href=@Url.Action("Index", "Home")> <i class="fa-solid fa-home text-primary me-1"></i> Home </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-light" href=@Url.Action("Create", "Contacts")> <i class="fa-solid fa-user-plus text-primary me-1"></i> Add Contact </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-light" href=@Url.Action("Index", "Contacts")> <i class="fa-solid fa-address-book text-primary me-1"></i> View All Contacts </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer class="container-fluid bg-dark text-white text-center">
            <p>&copy; @DateTime.Now.Year - PhoneBook Inc.</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <script src="~/Scripts/Datatables/js/datatables.min.js"></script>
    <script src="~/Scripts/FontAwesome/js/all.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
</body>
</html>
