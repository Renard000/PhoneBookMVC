@model List<PhoneBook.Models.Contact>
@{
    ViewBag.Title = "All Contacts";
}

<div class="container mt-4">
    <h2 class="text-center mb-4"><i class="fa-solid fa-address-book text-primary"></i> @ViewBag.Title</h2>
    <div class="table-responsive">
        <table class="table table-striped-primary table-hover table-bordered">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contact in Model)
                {
                    <tr>
                        <td>@contact.FirstName</td>
                        <td>@contact.LastName</td>
                        <td>@contact.Phone</td>
                        <td>@contact.Email</td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = contact.Id })" class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-edit me-1"></i> Edit
                            </a>
                            <a href="@Url.Action("Delete", new { id = contact.Id })" class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-trash me-1"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            new DataTable('.table', {
                pageLength: 5,
                lengthMenu: [5, 10, 25, 50],
                searching: true,
                ordering: true
            });
        });
    </script>
}
