@model PhoneBook.Models.Contact
@{
    ViewBag.Title = "Delete Contact";
}

<div class="container">

    <div class="row">
        <div class="col-md-6 col-lg-6 col-sm-8 mx-auto">
            <div  class="card shadow-sm">
                <div class="card-body">
                    <h2 class="text-center text-danger mb-4">
                        <i class="fa-solid fa-trash-can me-2"></i>@ViewBag.Title
                    </h2>

                    <div class="alert alert-warning text-center">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        Are you sure you want to delete this contact?
                    </div>

                    <div class="mb-3"><strong>First name:</strong> @Model.FirstName</div>
                    <div class="mb-3"><strong>Last name:</strong> @Model.LastName</div>
                    <div class="mb-3"><strong>Phone:</strong> @Model.Phone</div>
                    <div><strong>Email:</strong> @Model.Email</div>

                    @using (Html.BeginForm("DeleteConfirmed", "Contacts", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m=>m.Id)
                        <div class="mt-4 d-flex justify-content-center">
                            <button type="submit" class="btn btn-danger me-2">
                                <i class="fa-solid fa-trash-can me-1"></i> Delete
                            </button>
                            <a href="@Url.Action("Index","Contacts")" class="btn btn-secondary ms-2">
                                <i class="fa-solid fa-xmark me-1"></i> Cancel
                            </a>
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>

</div>

